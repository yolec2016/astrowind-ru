---
/**
 * ProductsGrid.astro — сетка реальных серийных моделей фабрики
 * Данные взяты с основного сайта yolec-electronics.com (WooCommerce каталог).
 */
export interface Product {
  model: string;
  title: string;
  tag: string;
  image: string;
  image2?: string;
  url: string;
}

export interface Props {
  tagline?: string;
  title?: string;
  subtitle?: string;
  products: Product[];
}

const {
  tagline = 'Модельный ряд',
  title = 'Серийные модели нашего завода',
  subtitle = 'Готовые OEM/ODM-модели: возможен ребрендинг, изменение цвета, упаковки и функций под ваш рынок.',
  products,
} = Astro.props;
---

<section class="bg-slate-50 py-20 dark:bg-slate-900 lg:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">{tagline}</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        {title}
      </h2>
      <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
        {subtitle}
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        products.map((p) => (
          <div class="group flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200 transition hover:shadow-xl dark:bg-slate-800 dark:ring-slate-700">
            <a
              href={p.url}
              target="_blank"
              rel="noopener nofollow"
              class="relative block aspect-square overflow-hidden bg-slate-100 dark:bg-slate-700"
              title={`Модель ${p.model} — полные характеристики на сайте производителя`}
            >
              <img
                src={p.image}
                alt={`${p.title} (модель ${p.model}) — продукция фабрики YOLEC`}
                class="h-full w-full object-cover transition duration-500 group-hover:opacity-0"
                loading="lazy"
                width="600"
                height="600"
              />
              {p.image2 && (
                <img
                  src={p.image2}
                  alt={`${p.title} (модель ${p.model}) — дополнительный ракурс`}
                  class="absolute inset-0 h-full w-full object-cover opacity-0 transition duration-500 group-hover:opacity-100"
                  loading="lazy"
                  width="600"
                  height="600"
                />
              )}
              <span class="absolute left-3 top-3 rounded-full bg-accent px-3 py-1 text-xs font-semibold text-white shadow">
                {p.tag}
              </span>
            </a>

            <div class="flex flex-1 flex-col p-5">
              <a
                href={p.url}
                target="_blank"
                rel="noopener nofollow"
                class="text-sm font-bold tracking-wide text-slate-900 hover:text-accent dark:text-white"
              >
                Модель {p.model}
              </a>
              <p class="mt-2 flex-1 text-sm leading-6 text-slate-600 dark:text-slate-300">{p.title}</p>
              <div class="mt-4 flex items-center justify-between gap-2">
                <a
                  href="/contact"
                  class="inline-flex items-center rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white transition hover:opacity-90"
                >
                  Запросить цену
                </a>
                <span class="text-xs text-slate-400">OEM / ODM · MOQ от 500 шт</span>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <p class="mt-10 text-center text-sm text-slate-500 dark:text-slate-400">
      Полный каталог из 80+ моделей — на основном сайте фабрики. Подберите базовую модель, и мы адаптируем её под ваш
      бренд: логотип, цвет корпуса, упаковка, комплектация и сертификация под рынок ЕАЭС.
    </p>
  </div>
</section>
