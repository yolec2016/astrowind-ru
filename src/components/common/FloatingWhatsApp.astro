---
import { Icon } from 'astro-icon/components';

/**
 * FloatingWhatsApp.astro — плавающая кнопка WhatsApp на всех страницах.
 * Повторяет поведение кнопки на основном сайте: круг 60px, подсказка при наведении.
 */
const phone = '8613922332584';
const message = 'Здравствуйте! Хочу запросить КП на OEM/ODM производство кухонной техники.';
const href = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;

const pathname = Astro.url.pathname;
const isHidden = pathname.startsWith('/decapcms');
---

{
  !isHidden && (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Написать в WhatsApp"
      title="Написать в WhatsApp"
      class="group fixed z-[9998] inline-flex h-[60px] w-[60px] items-center justify-center rounded-full border-2 border-white/90 bg-[#25d366] text-white shadow-[0_10px_26px_rgb(18_140_74_/_0.4)] transition duration-200 ease-out hover:-translate-y-0.5 hover:scale-[1.04] hover:bg-[#1ebe5d] hover:shadow-[0_15px_32px_rgb(18_140_74_/_0.5)] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[#F5B93F]"
      style="right: clamp(16px, 2.5vw, 28px); bottom: max(18px, calc(env(safe-area-inset-bottom) + 12px));"
    >
      <Icon name="tabler:brand-whatsapp" class="h-[30px] w-[30px]" aria-hidden="true" />

      <span class="pointer-events-none absolute right-[calc(100%+12px)] top-1/2 hidden -translate-y-1/2 translate-x-1.5 whitespace-nowrap rounded-md bg-[#1f1f1f] px-3.5 py-2 text-[13px] font-semibold leading-none text-white opacity-0 shadow-[0_6px_18px_rgb(0_0_0_/_0.28)] transition duration-200 ease-out group-hover:translate-x-0 group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:opacity-100 lg:block">
        Написать в WhatsApp
      </span>
    </a>
  )
}
