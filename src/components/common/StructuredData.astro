// ---------- BreadcrumbList ----------
function buildBreadcrumb(): Record<string, unknown> | null {
  const cleanPath = pagePath.replace(/\/+$/, '');
  const parts = cleanPath.split('/').filter(Boolean);
  if (parts.length === 0) return null; // homepage: no breadcrumb needed
  const items: Array<Record<string, unknown>> = [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Главная',
      item: SITE.site,
    },
  ];
  let acc = '';
  parts.forEach((seg, idx) => {
    acc += `/${seg}`;
    const isLast = idx === parts.length - 1;
    let prettyName: string;
    if (isLast && pageTitle) {
      prettyName = pageTitle.replace(/\s*\|.*/, '').trim();
    } else if (seg === 'blog') {
      prettyName = 'Блог';
    } else if (seg === 'category') {
      prettyName = 'Категории';
    } else if (seg === 'tag') {
      prettyName = 'Теги';
    } else {
      prettyName = seg
        .replace(/-/g, ' ')
        .replace(/manufacturer/gi, 'Производитель')
        .replace(/\b\w/g, (m) => m.toUpperCase());
    }
    items.push({
      '@type': 'ListItem',
      position: idx + 2,
      name: prettyName,
      item: `${SITE.site.replace(/\/$/, '')}${acc}`,
    });
  });
  return {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: items,
  };
}

