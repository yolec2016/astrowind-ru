/**
 * StructuredData.astro — Schema.org JSON-LD for YOLEC Russian site
 *
 * Current schema strategy:
 * - Organization: site-wide
 * - WebSite: site-wide
 * - BreadcrumbList: internal pages
 * - BlogPosting: blog articles
 * - Product: ONLY when explicitly supplied by a real product detail page
 *
 * IMPORTANT:
 * Manufacturer/category landing pages must NOT automatically output
 * Product Schema. Product Rich Results should be reserved for
 * individual product detail pages.
 */
import { SITE, METADATA } from 'astrowind:config';

export interface BlogPostSchemaInput {
  slug: string;
  title: string;
  description?: string;
  publishDate?: Date;
  updateDate?: Date;
  image?: string;
  tags?: string[];
  authorName?: string;
  category?: string;
  bodyExcerpt?: string;
}

export interface ProductSchemaInput {
  name: string;
  description?: string;
  image?: string | string[];
  sku?: string;
  mpn?: string;
  brand?: string;
  category?: string;
  url?: string;
  additionalProperty?: Array<Record<string, unknown>>;
  offers?: Record<string, unknown>;
}

export interface Props {
  data?: Record<string, unknown> | Array<Record<string, unknown>>;
  pagePath?: string;
  pageTitle?: string;
  blogPost?: BlogPostSchemaInput;
  product?: ProductSchemaInput;
}

