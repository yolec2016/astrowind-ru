// ---------- Aggregate schemas ----------
const schemas: Array<Record<string, unknown>> = [];
schemas.push(organization);
schemas.push(website);
const breadcrumb = buildBreadcrumb();
if (breadcrumb) schemas.push(breadcrumb);

const pk = detectProductKey(pagePath);
if (pk) {
  const ps = buildProduct(pk);
  if (ps) schemas.push(ps);
}

if (blogPost) {
  schemas.push(buildBlogPosting(blogPost));
}

if (data) {
  if (Array.isArray(data)) schemas.push(...(data as Array<Record<string, unknown>>));
  else schemas.push(data as Record<string, unknown>);
}
