type ProductKey = 'electric-kettle' | 'rice-cooker' | 'electric-pressure-cooker' | 'electric-lunch-box';

function detectProductKey(p: string): ProductKey | null {
  if (p.includes('electric-kettle')) return 'electric-kettle';
  if (p.includes('rice-cooker')) return 'rice-cooker';
  if (p.includes('electric-pressure-cooker')) return 'electric-pressure-cooker';
  if (p.includes('electric-lunch-box')) return 'electric-lunch-box';
  return null;
}

