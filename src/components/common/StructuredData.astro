  url: siteUrl,
  name: SITE.name || 'YOLEC Electric',
  inLanguage: 'ru-RU',
  publisher: {
    '@id': orgId,
  },

  potentialAction: [
    {
      '@type': 'SearchAction',
      target: `${siteUrl}/blog?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  ],
};

// ---------- BreadcrumbList ----------
function buildBreadcrumb(): Record<string, unknown> | null {
  const cleanPath = pagePath.replace(/\/+$/, '');

  const parts = cleanPath.split('/').filter(Boolean);

  if (parts.length === 0) {
    return null;
  }

  const items: Array<Record<string, unknown>> = [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Главная',
      item: siteUrl,
    },
  ];

  let acc = '';

  parts.forEach((seg, idx) => {
    acc += `/${seg}`;

    const isLast = idx === parts.length - 1;

    let prettyName: string;

    if (isLast && pageTitle) {
      prettyName = pageTitle.replace(/\s*\|.*/, '').trim();
    } else if (seg === 'blog') {
      prettyName = 'Блог';
    } else if (seg === 'category') {
      prettyName = 'Категории';
    } else if (seg === 'tag') {
      prettyName = 'Теги';
    } else {
      prettyName = seg
        .replace(/-/g, ' ')
        .replace(/manufacturer/gi, 'Производитель')
        .replace(/\b\w/g, (m) => m.toUpperCase());
    }

    items.push({
      '@type': 'ListItem',
      position: idx + 2,
      name: prettyName,
      item: `${siteUrl}${acc}`,
    });
  });

  return {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: items,
  };
}

// ---------- Product ----------
/**
 * Product Schema is intentionally opt-in.
 *
 * A page becomes a Product page ONLY when the page explicitly
 * passes the `product` prop.
 *
 * This prevents manufacturer/category landing pages such as:
 * /electric-kettle-manufacturer/
 * /electric-rice-cooker-manufacturer/
 * from being treated as individual products.
 */
function buildProductSchema(
  p: ProductSchemaInput
): Record<string, unknown> {
  const productUrl = p.url
    ? p.url.startsWith('http')
      ? p.url
      : `${siteUrl}${p.url}`
    : pageUrl;

  const schema: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': 'Product',

    name: p.name,

    description: p.description || undefined,

    image: p.image
      ? Array.isArray(p.image)
        ? p.image.map((img) =>
            img.startsWith('http') ? img : `${siteUrl}${img}`
          )
        : [
            p.image.startsWith('http')
              ? p.image
              : `${siteUrl}${p.image}`,
          ]
      : undefined,

    sku: p.sku || undefined,
    mpn: p.mpn || undefined,

    category: p.category || undefined,

    brand: {
      '@type': 'Brand',
      name: p.brand || 'YOLEC Electric',
      url: siteUrl,
    },

    manufacturer: {
      '@id': orgId,
    },

    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': productUrl,
    },

    url: productUrl,

    inLanguage: 'ru-RU',
  };

  if (p.additionalProperty?.length) {
    schema.additionalProperty = p.additionalProperty;
  }

  if (p.offers) {
    schema.offers = p.offers;
  }

  return schema;
}

// ---------- BlogPosting ----------
function buildBlogPosting(
  bp: BlogPostSchemaInput
): Record<string, unknown> {
  const postUrl = `${siteUrl}/blog/${bp.slug}`;

  return {
    '@context': 'https://schema.org',
    '@type': ['BlogPosting', 'Article'],

    headline: bp.title,

    description: bp.description || '',

    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': postUrl,
    },

    datePublished: bp.publishDate
      ? new Date(bp.publishDate).toISOString()
      : new Date().toISOString(),

    dateModified: bp.updateDate
      ? new Date(bp.updateDate).toISOString()
      : bp.publishDate
        ? new Date(bp.publishDate).toISOString()
        : new Date().toISOString(),

    inLanguage: 'ru-RU',

    keywords: (bp.tags || []).join(', '),

    articleSection:
      bp.category ||
      'Блог фабрики Zhongshan Yangle Electric — бренд YOLEC',

    wordCount: (bp.bodyExcerpt || '').length,

    author: {
      '@type': 'Person',
      name: bp.authorName || 'Adrian YOLEC',
      jobTitle:
        'B2B Sales Director — Zhongshan Yangle Electric Appliance Co., Ltd.',
      worksFor: {
        '@id': orgId,
      },
      url: 'https://www.linkedin.com/in/adrian2010/',
      sameAs: [
        'https://wa.me/8613922332584',
        'https://www.linkedin.com/in/adrian2010/',
      ],
      affiliate: {
        '@id': orgId,
      },
      knowsAbout: [
        'OEM мелкой бытовой техники',
        'Китайские фабрики',
        'B2B импорт электрочайников',
        'Логистика ЕАЭС',
        'Сертификация EAC',
        'OEM/ODM производство рисоварок',
        'Контроль качества на китайской фабрике',
      ],
      hasCredential: [
        {
          '@type': 'EducationalOccupationalCredential',
          name: 'Компания верифицирована SGS (отчёт 483515034-P+T)',
        },
      ],
    },

    editor: {
      '@type': 'Person',
      name: 'Adrian YOLEC',
      worksFor: {
        '@id': orgId,
      },
    },

    publisher: {
      '@id': orgId,
    },

    image: bp.image
      ? {
          '@type': 'ImageObject',
          url: bp.image.startsWith('http')
            ? bp.image
            : `${siteUrl}${bp.image}`,
        }
      : undefined,

    articleBody: bp.bodyExcerpt
      ? bp.bodyExcerpt.slice(0, 500)
      : undefined,

    potentialAction: {
      '@type': 'ReadAction',
      target: postUrl,
      name: 'Читать статью',
    },
  };
}

// ---------- Aggregate schemas ----------
const schemas: Array<Record<string, unknown>> = [];

// Site-wide schemas
schemas.push(organization);
schemas.push(website);

// Breadcrumb
const breadcrumb = buildBreadcrumb();

if (breadcrumb) {
  schemas.push(breadcrumb);
}

// Product
//
// IMPORTANT:
// There is NO automatic URL-based Product detection anymore.
// Product Schema is generated only when a real product detail page
// explicitly passes the `product` prop.
if (product) {
  schemas.push(buildProductSchema(product));
}

// Blog
if (blogPost) {
  schemas.push(buildBlogPosting(blogPost));
}

// Additional custom schema
if (data) {
  if (Array.isArray(data)) {
    schemas.push(...(data as Array<Record<string, unknown>>));
  } else {
    schemas.push(data as Record<string, unknown>);
  }
}
---

{schemas.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}