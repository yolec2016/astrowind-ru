// ---------- BlogPosting ----------
function buildBlogPosting(bp: BlogPostSchemaInput): Record<string, unknown> {
  const postUrl = `${SITE.site.replace(/\/$/, '')}/blog/${bp.slug}`;
  return {
    '@context': 'https://schema.org',
    '@type': ['BlogPosting', 'Article'],
    headline: bp.title,
    description: bp.description || '',
    mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
    datePublished: bp.publishDate ? new Date(bp.publishDate).toISOString() : new Date().toISOString(),
    dateModified: bp.updateDate
      ? new Date(bp.updateDate).toISOString()
      : bp.publishDate
        ? new Date(bp.publishDate).toISOString()
        : new Date().toISOString(),
    inLanguage: 'ru-RU',
    keywords: (bp.tags || []).join(', '),
    articleSection: bp.category || 'Блог фабрики Zhongshan Yangle Electric — бренд YOLEC',
    wordCount: (bp.bodyExcerpt || '').length,
    author: {
      '@type': 'Person',
      name: bp.authorName || 'Adrian YOLEC',
      jobTitle: 'B2B Sales Director — Zhongshan Yangle Electric Appliance Co., Ltd.',
      worksFor: { '@id': orgId },
      url: 'https://www.linkedin.com/in/adrian2010/',
      sameAs: ['https://wa.me/8613922332584', 'https://www.linkedin.com/in/adrian2010/'],
      affiliate: { '@id': orgId },
      knowsAbout: [
        'OEM мелкой бытовой техники',
        'Китайские фабрики',
        'B2B импорт электрочайников',
        'Логистика ЕАЭС',
        'Сертификация EAC',
        'OEM/ODM производство рисоварок',
        'Контроль качества на китайской фабрике',
      ],
      hasCredential: [
        {
          '@type': 'EducationalOccupationalCredential',
          name: 'Компания верифицирована SGS (отчёт 483515034-P+T)',
        },
      ],
    },
    editor: {
      '@type': 'Person',
      name: 'Adrian YOLEC',
      worksFor: { '@id': orgId },
    },
    publisher: { '@id': orgId },
    image: bp.image
      ? {
          '@type': 'ImageObject',
          url: bp.image.startsWith('http') ? bp.image : `${SITE.site.replace(/\/$/, '')}${bp.image}`,
        }
      : undefined,
    articleBody: bp.bodyExcerpt ? bp.bodyExcerpt.slice(0, 500) : undefined,
    potentialAction: {
