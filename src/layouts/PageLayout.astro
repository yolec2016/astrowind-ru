---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import Announcement from '~/components/widgets/Announcement.astro';
import StructuredData from '~/components/common/StructuredData.astro';

import { headerData, footerData } from '~/navigation';

import { ANALYTICS } from 'astrowind:config';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  /** Extra JSON-LD nodes (e.g. homepage AggregateRating + Reviews) */
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { metadata, structuredData } = Astro.props;
const _gaId = ANALYTICS?.googleAnalytics?.id || '';
---

<Layout metadata={metadata}>
  <slot name="announcement">
    <Announcement />
  </slot>
  <slot name="header">
    <Header {...headerData} isSticky showRssFeed showToggleTheme />
  </slot>
  <main>
    <slot />
  </main>
  <slot name="footer">
    <Footer {...footerData} />
  </slot>
</Layout>

<StructuredData
  pagePath={Astro.url.pathname}
  pageTitle={typeof metadata?.title === 'string' ? metadata.title : undefined}
  data={structuredData}
/>

<!-- Google Analytics 4 -->
{
  _gaId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${_gaId}`} />
      <script
        is:inline
        set:html={`window.dataLayer = window.dataLayer || [];
function gtag(...args) { dataLayer.push(...args); }
gtag('js', new Date());
gtag('config', '${_gaId}', { send_page_view: true });`}
      />
    </>
  )
}
