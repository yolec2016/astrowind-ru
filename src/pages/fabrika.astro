---
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Наш завод в Китае — цех, лаборатория и сертификаты OEM/ODM',
  description:
    'Производственная база в Чжуншане (Гуандун): 20 000 м², 200+ сотрудников, цеха литья и штамповки, лаборатория испытаний. Фото цехов и сертификаты CE, CB, CCC, TÜV.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="О заводе YOLEC Electric"
    image={{
      src: '~/assets/images/factory.png',
      alt: 'Завод YOLEC Electric — производитель кухонной техники OEM/ODM в Китае',
    }}
  >
    <Fragment slot="title">
      Фабрика кухонной техники <br />
      <span class="text-accent dark:text-white">в Чжуншане, Китай</span>
    </Fragment>

    <Fragment slot="subtitle">
      <strong>Zhongshan Yangle Electric (торговая марка YOLEC)</strong> — производственное предприятие в городе Дунфэн, Чжуншань
      (провинция Гуандун), <strong>основано в 2015 году</strong>. Производим мелкую кухонную технику под маркой
      заказчика: электрочайники, рисоварки, мультиварки-скороварки и электрические ланч-боксы. Верифицированы SGS (отчёт
      483515034-P+T), процент повторных заказов клиентов — более 80 %. Работаем напрямую с импортерами, дистрибьюторами
      и брендами — без посредников.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="Завод в цифрах — с 2015 года на рынке OEM/ODM"
    stats={[
      { title: 'Площадь производства', amount: '20 000 м²' },
      { title: 'Сотрудники', amount: '200+' },
      { title: 'Инженеры R&D', amount: '13' },
      { title: 'Производство в месяц', amount: '≈ 200K' },
    ]}
  />

  <!-- ПРОИЗВОДСТВЕННЫЕ ЦЕХА (реальные фото фабрики) *** -->

  <section class="bg-white py-20 dark:bg-slate-950 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">Производство</p>

      <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        Цеха нашей фабрики в Чжуншане
      </h2>

      <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600 dark:text-slate-300">
        На площадке 20 000 м² все этапы производства сосредоточены на одном предприятии: литьё пластика, штамповка
        металла, полировка, сборка и лаборатория испытаний. Перед началом OEM-проекта вы можете лично проверить фабрику
        — приехать с аудитом или провести видеоинспекцию.
      </p>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <figure
          class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900"
        >
          <img
            src="/images/factory/taller-inyeccion.jpg"
            alt="Цех литья пластика фабрики YOLEC Electric в Чжуншане, Китай"
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
          />
          <figcaption class="p-4 text-sm font-semibold text-slate-700 dark:text-slate-200">
            Цех литья пластика
          </figcaption>
        </figure>

        <figure
          class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900"
        >
          <img
            src="/images/factory/taller-estampado.jpg"
            alt="Цех штамповки металла для корпусов кухонной техники OEM"
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
          />
          <figcaption class="p-4 text-sm font-semibold text-slate-700 dark:text-slate-200">
            Цех штамповки металла
          </figcaption>
        </figure>

        <figure
          class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900"
        >
          <img
            src="/images/factory/pulido-producto.jpg"
            alt="Полировка изделий на производстве мелкой кухонной техники YOLEC"
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
          />
          <figcaption class="p-4 text-sm font-semibold text-slate-700 dark:text-slate-200">
            Полировка и финишная обработка
          </figcaption>
        </figure>

        <figure
          class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900"
        >
          <img
            src="/images/factory/laboratorio-pruebas.jpg"
            alt="Лаборатория испытаний качества и безопасности продукции YOLEC Electric"
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
          />
          <figcaption class="p-4 text-sm font-semibold text-slate-700 dark:text-slate-200">
            Лаборатория испытаний
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- МЕЖДУНАРОДНЫЕ СЕРТИФИКАТЫ ************************ -->

  <section class="bg-slate-50 py-20 dark:bg-slate-900 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">Сертифицированное качество</p>

      <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        Сертификаты: CE, RoHS, CB, CCC, TÜV и LFGB
      </h2>

      <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600 dark:text-slate-300">
        Строгая система контроля качества действует на каждом этапе — от закупки сырья до финальной инспекции. Продукция
        проходит сертификацию под требования ЕАЭС, ЕС, Северной Америки и Ближнего Востока. Дополнительно поддерживаем
        сертификацию под конкретный рынок назначения.
      </p>

      <ul class="mt-8 grid gap-4 text-base leading-7 text-slate-600 dark:text-slate-300 sm:grid-cols-2">
        <li class="flex gap-3">
          <span class="text-accent">✓</span><span><strong>CE</strong> — соответствие директивам безопасности ЕС</span>
        </li>
        <li class="flex gap-3">
          <span class="text-accent">✓</span><span
            ><strong>RoHS</strong> — экологические требования для рынка Европы</span
          >
        </li>
        <li class="flex gap-3">
          <span class="text-accent">✓</span><span><strong>CB</strong> — международное признание для десятков стран</span
          >
        </li>
        <li class="flex gap-3">
          <span class="text-accent">✓</span><span
            ><strong>LFGB</strong> — допуск к контакту с пищевыми продуктами (Германия)</span
          >
        </li>
        <li class="flex gap-3">
          <span class="text-accent">✓</span><span><strong>CCC</strong> — обязательная сертификация для рынка Китая</span
          >
        </li>
        <li class="flex gap-3">
          <span class="text-accent">✓</span><span><strong>TÜV</strong> — испытания независимым германским органом</span>
        </li>
        <li class="flex gap-3">
          <span class="text-accent">✓</span><span
            ><strong>ETL</strong> — сертификация безопасности для Северной Америки</span
          >
        </li>
        <li class="flex gap-3">
          <span class="text-accent">✓</span><span
            ><strong>Intertek</strong> — тестирование в независимой лаборатории</span
          >
        </li>
      </ul>

      <div class="mt-12 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-6">
        <figure
          class="flex items-center justify-center rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-950"
        >
          <img
            src="/images/factory/certificado-ccc.png"
            alt="Сертификат CCC завода YOLEC Electric для рынка Китая"
            class="max-h-56 w-auto object-contain"
            loading="lazy"
          />
        </figure>
        <figure
          class="flex items-center justify-center rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-950"
        >
          <img
            src="/images/factory/certificado-cb.png"
            alt="Международный сертификат CB завода YOLEC Electric"
            class="max-h-56 w-auto object-contain"
            loading="lazy"
          />
        </figure>
        <figure
          class="flex items-center justify-center rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-950"
        >
          <img
            src="/images/factory/certificado-tuv.png"
            alt="Сертификат TÜV YOLEC Electric — испытания германским органом"
            class="max-h-56 w-auto object-contain"
            loading="lazy"
          />
        </figure>
        <figure
          class="flex items-center justify-center rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-950"
        >
          <img
            src="/images/factory/certificado-ce.png"
            alt="Сертификат CE — соответствие нормам ЕС, завод YOLEC Electric"
            class="max-h-56 w-auto object-contain"
            loading="lazy"
          />
        </figure>
        <figure
          class="flex items-center justify-center rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-950"
        >
          <img
            src="/images/factory/certificado-intertek-1.png"
            alt="Отчет об испытаниях, проверенный Intertek — YOLEC Electric"
            class="max-h-56 w-auto object-contain"
            loading="lazy"
          />
        </figure>
        <figure
          class="flex items-center justify-center rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-950"
        >
          <img
            src="/images/factory/certificado-intertek-2.png"
            alt="Сертификация независимой лаборатории Intertek для техники YOLEC"
            class="max-h-56 w-auto object-contain"
            loading="lazy"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- ВИДЕО С ФАБРИКИ (YouTube) ************************ -->

  <section class="bg-white py-20 dark:bg-slate-950 lg:py-28">
    <div class="mx-auto max-w-4xl px-6 text-center lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">Фабрика в видео</p>

      <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        Посмотрите наш завод изнутри на YouTube
      </h2>

      <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
        Мы публикуем реальные видео производства, испытаний продукции и сборочных линий на официальном YouTube-канале.
        Полная прозрачность — часть нашей работы с брендами и импортерами.
      </p>

      <div class="mt-10 overflow-hidden rounded-2xl shadow-xl">
        <div class="relative aspect-video w-full">
          <iframe
            class="absolute inset-0 h-full w-full"
            src="https://www.youtube.com/embed/rEMDD8mcuqM"
            title="Видео с фабрики YOLEC Electric — производство кухонной техники в Китае"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            loading="lazy"
            allowfullscreen></iframe>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="https://www.youtube.com/@yolec-electric-adrian"
          target="_blank"
          rel="noopener nofollow"
          class="inline-flex items-center gap-2 rounded-full bg-red-600 px-6 py-3 text-base font-semibold text-white shadow-lg transition hover:bg-red-700"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
            <path
              d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8ZM9.6 15.6V8.4L15.8 12l-6.2 3.6Z"
            ></path>
          </svg>
          Все видео фабрики на YouTube-канале
        </a>
      </div>
    </div>
  </section>

  <!-- ОСНОВНЫЕ НАПРАВЛЕНИЯ **************************** -->

  <Features2
    title="Наши компетенции"
    subtitle="OEM/ODM производство кухонной техники со стабильным качеством и масштабируемыми объемами."
    tagline="Специализация"
    columns={3}
    items={[
      {
        title: 'OEM-разработка',
        description: 'Производим продукцию по дизайну, марке и техническим требованиям заказчика.',
        icon: 'tabler:template',
      },
      {
        title: 'ODM-разработка',
        description: 'Готовые модели для быстрой кастомизации и вывода на рынок.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Контроль качества',
        description: 'Строгая инспекция на каждом этапе производства для стабильности партий.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Частные марки и e-commerce',
        description: 'Поддерживаем бренды и международных продавцов в запуске продукции.',
        icon: 'tabler:shopping-cart',
      },
      {
        title: 'Глобальный экспорт',
        description: 'Опыт поставок в Европу, Америку, на Ближний Восток и в Африку.',
        icon: 'tabler:world',
      },
      {
        title: 'B2B-решения',
        description: 'Полный цикл для импортеров, дистрибьюторов и оптовых компаний.',
        icon: 'tabler:briefcase',
      },
    ]}
  />

  <!-- ГЕОГРАФИЯ И ЛОГИСТИКА *************************** -->

  <Features2
    title="География и экспорт"
    subtitle="Наш рост основан на доверии международных клиентов и стабильном производстве."
    tagline="Достижения"
    columns={3}
    items={[
      {
        title: '60+ стран',
        description: 'Экспортируем кухонную технику более чем в шестьдесят стран мира.',
      },
      {
        title: '200+ B2B-клиентов',
        description: 'Долгосрочные отношения с импортерами и дистрибьюторами.',
      },
      {
        title: 'Надежный поставщик',
        description: 'Репутация в отрасли OEM-производства мелкой бытовой техники.',
      },
    ]}
  />

  <!-- ЛОКАЦИЯ ***************************************** -->

  <Features2
    title="Расположение"
    tagline="Наша фабрика"
    columns={4}
    items={[
      {
        title: 'Китай — Чжуншань',
        description: 'Гуандун — основная производственная площадка OEM/ODM',
      },
      {
        title: 'Прямое производство',
        description: 'Без посредников, отгрузка напрямую с завода',
      },
      {
        title: 'Глобальный экспорт',
        description: 'Европа, Америка, Ближний Восток и Африка',
      },
      {
        title: 'Поддержка B2B',
        description: 'Сопровождение импортеров и дистрибьюторов',
      },
    ]}
  />
</Layout>
