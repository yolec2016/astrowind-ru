              лет производства
            </div>

            <div>
              <strong class="text-slate-900 dark:text-white">20 000㎡</strong>
              площадь фабрики
            </div>

            <div>
              <strong class="text-slate-900 dark:text-white">200+</strong>
              сотрудников
            </div>

          </div>

        </div>


        <!-- RIGHT -->

        <div class="relative">

          <div class="overflow-hidden rounded-2xl bg-white shadow-2xl ring-1 ring-slate-200 dark:bg-slate-800 dark:ring-slate-700">

            <img
              src="/images/blog/5.jpg"
