---
import Layout from '~/layouts/PageLayout.astro';
import ProductsGrid from '~/components/widgets/ProductsGrid.astro';

const metadata = {
  title: 'Производитель рисоварок в Китае | OEM & ODM завод',
  description:
    'Завод рисоварок и мультиварок в Китае: от 0,6 до 10 л, механические и цифровые модели, OEM под вашим брендом. Сертификация CE/CB/EAC/LFGB.',
  ignoreTitleTemplate: true,
};

const products = [
  {
    model: 'HS-MU120',
    tag: 'Мини 1,2 л',
    title: 'Мини-рисоварка 1,2 л для общежитий, офисов и отельного сегмента HoReCa.',
    image: '/images/products/rice/HS-MU120-1.jpg',
    image2: '/images/products/rice/HS-MU120-2.png',
    url: 'https://www.yolec-electronics.com/products/mini-cooker/oem-1-2l-mini-rice-cooker-for-dorms-hs-mu120/',
  },
  {
    model: 'HS-30A',
    tag: 'Мини 3 л / 12 программ',
    title: 'Мини-рисоварка 3 л с 12 программами для семьи из 2–3 человек.',
    image: '/images/products/rice/HS-30A-1.png',
    image2: '/images/products/rice/HS-30A-2.png',
    url: 'https://www.yolec-electronics.com/products/mini-cooker/oem-3l-12-in-1-mini-rice-cooker-small-family-hs-30a/',
  },
  {
    model: 'HS-510',
    tag: 'Мультиварка 5 л',
    title: 'Мультиварка 5 л, 10 программ, чаша из нержавеющей стали 304.',
    image: '/images/products/rice/HS-510-1.jpg',
    image2: '/images/products/rice/HS-510-2.jpg',
    url: 'https://www.yolec-electronics.com/products/multi-cooker/oem-5l-10-in-1-304-ss-multi-cooker-hs-510/',
  },
  {
    model: 'HS-RS301',
    tag: 'Низкоуглеводная 3 л',
    title: 'Рисоварка low-sugar 3 л: технология отделения сахара для здорового питания.',
    image: '/images/products/rice/HS-RS301-1.png',
    image2: '/images/products/rice/HS-RS301-2.png',
    url: 'https://www.yolec-electronics.com/products/low-sugar-cooker/oem-3l-low-sugar-rice-cooker-for-couples-hs-rs301/',
  },
  {
    model: 'HS-R502',
    tag: 'Низкоуглеводная 5 л',
    title: 'Рисоварка low-sugar 5 л, 14 функций, чаша с покрытием из стали 304.',
    image: '/images/products/rice/HS-R502-1.jpg',
    image2: '/images/products/rice/HS-R502-2.png',
    url: 'https://www.yolec-electronics.com/products/low-sugar-cooker/oem-5l-14-function-low-sugar-rice-cooker-304-ss-hs-r502/',
  },
  {
    model: 'HS-520',
    tag: 'Большой объём 6 л',
    title: 'Мультиварка 6 л для большой семьи и сегмента HoReCa.',
    image: '/images/products/rice/HS-520-1.png',
    image2: '/images/products/rice/HS-520-2.png',
    url: 'https://www.yolec-electronics.com/products/multi-cooker/oem-6l-large-capacity-304-ss-multi-cooker-hs-520/',
  },
];
---

<Layout metadata={metadata}>
  <!-- =========================================================
       HERO
  ========================================================== -->

  <section class="relative overflow-hidden bg-slate-50 dark:bg-slate-900">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-28">
      <div class="grid items-center gap-14 lg:grid-cols-2">
        <!-- LEFT -->

        <div>
          <div
            class="mb-6 inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-600 shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300"
          >
            Electric Rice Cooker Manufacturer · Supplier & Factory
          </div>

          <h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-5xl lg:text-6xl">
            Производитель рисоварок
            <span class="block text-accent"> в Китае — завод-поставщик </span>
          </h1>

          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">
            Производим электрические рисоварки для импортеров, дистрибьюторов, оптовых компаний и private label брендов.
            Предлагаем прямые поставки с фабрики, OEM и ODM производство, а также персонализацию продукции под
            требования разных международных рынков.
          </p>

          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="/contact"
              class="inline-flex items-center rounded-lg bg-accent px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:opacity-90"
            >
              Запросить предложение
            </a>

            <a
              href="https://wa.me/8613922332584"
              class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-6 py-3.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:bg-slate-800 dark:text-white dark:hover:bg-slate-700"
            >
              Связаться через WhatsApp
            </a>
          </div>

          <div class="mt-10 flex flex-wrap gap-x-8 gap-y-4 text-sm text-slate-600 dark:text-slate-400">
            <div>
              <strong class="text-slate-900 dark:text-white">10+</strong>
              лет производства
            </div>

            <div>
              <strong class="text-slate-900 dark:text-white">20 000㎡</strong>
              площадь фабрики
            </div>

            <div>
              <strong class="text-slate-900 dark:text-white">200+</strong>
              сотрудников
            </div>
          </div>
        </div>

        <!-- RIGHT -->

        <div class="relative">
          <div
            class="overflow-hidden rounded-2xl bg-white shadow-2xl ring-1 ring-slate-200 dark:bg-slate-800 dark:ring-slate-700"
          >
            <img
              src="/images/blog/5.jpg"
              alt="Electric rice cooker manufacturer in China - OEM и ODM производство рисоварок"
              class="h-auto w-full object-cover"
              loading="eager"
            />
          </div>

          <div
            class="absolute -bottom-6 -left-6 hidden rounded-xl bg-white p-5 shadow-xl ring-1 ring-slate-200 dark:bg-slate-800 dark:ring-slate-700 sm:block"
          >
            <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Прямое производство</p>

            <p class="mt-1 text-lg font-bold text-slate-900 dark:text-white">OEM / ODM</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       TRUST / STATS
  ========================================================== -->

  <section class="border-y border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950">
    <div class="mx-auto grid max-w-6xl grid-cols-2 divide-x divide-slate-200 dark:divide-slate-800 lg:grid-cols-4">
      <div class="px-6 py-8 text-center">
        <div class="text-3xl font-bold text-slate-900 dark:text-white">10+</div>
        <div class="mt-1 text-sm text-slate-500">Лет производства</div>
      </div>

      <div class="px-6 py-8 text-center">
        <div class="text-3xl font-bold text-slate-900 dark:text-white">20 000㎡</div>
        <div class="mt-1 text-sm text-slate-500">Площадь фабрики</div>
      </div>

      <div class="border-t px-6 py-8 text-center dark:border-slate-800 lg:border-t-0">
        <div class="text-3xl font-bold text-slate-900 dark:text-white">200+</div>
        <div class="mt-1 text-sm text-slate-500">Сотрудников</div>
      </div>

      <div class="border-t px-6 py-8 text-center dark:border-slate-800 lg:border-t-0">
        <div class="text-3xl font-bold text-slate-900 dark:text-white">3</div>
        <div class="mt-1 text-sm text-slate-500">Производственные линии</div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       PRODUCT RANGE
  ========================================================== -->

  <section class="bg-white py-20 dark:bg-slate-950 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-accent">Наша продукция</p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
          Электрические рисоварки для разных рынков
        </h2>

        <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
          Как производитель электрических рисоварок, мы предлагаем различные модели и конфигурации для импортеров,
          дистрибьюторов и брендов. Покупатель может выбрать подходящую модель с учетом цены, емкости, дизайна и
          функциональности.
        </p>
      </div>

      <!-- PRODUCT IMAGE -->

      <div class="mt-12 overflow-hidden rounded-2xl">
        <img
          src="/images/blog/6.jpg"
          alt="Электрические рисоварки производства Китая для B2B покупателей"
          class="h-auto w-full object-cover"
          loading="lazy"
        />
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-7 dark:border-slate-800 dark:bg-slate-900">
          <div class="text-2xl font-bold text-slate-900 dark:text-white">01</div>

          <h3 class="mt-5 text-xl font-bold text-slate-900 dark:text-white">Электрические рисоварки</h3>

          <p class="mt-3 leading-7 text-slate-600 dark:text-slate-400">
            Практичные модели для повседневного приготовления риса, подходящие для различных каналов дистрибуции.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-7 dark:border-slate-800 dark:bg-slate-900">
          <div class="text-2xl font-bold text-slate-900 dark:text-white">02</div>

          <h3 class="mt-5 text-xl font-bold text-slate-900 dark:text-white">Рисоварки с дополнительными функциями</h3>

          <p class="mt-3 leading-7 text-slate-600 dark:text-slate-400">
            Модели с дополнительными режимами и функциями для сегментов, где покупатели ожидают большего удобства.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-7 dark:border-slate-800 dark:bg-slate-900">
          <div class="text-2xl font-bold text-slate-900 dark:text-white">03</div>

          <h3 class="mt-5 text-xl font-bold text-slate-900 dark:text-white">Рисоварки разных объемов</h3>

          <p class="mt-3 leading-7 text-slate-600 dark:text-slate-400">
            Различные варианты вместимости позволяют подобрать модель под конкретный рынок, канал продаж и целевую
            аудиторию.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-7 dark:border-slate-800 dark:bg-slate-900">
          <div class="text-2xl font-bold text-slate-900 dark:text-white">04</div>

          <h3 class="mt-5 text-xl font-bold text-slate-900 dark:text-white">Private Label рисоварки</h3>

          <p class="mt-3 leading-7 text-slate-600 dark:text-slate-400">
            Персонализация логотипа, цвета, отделки, упаковки и других элементов в соответствии с требованиями вашего
            бренда.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       RELATED PRODUCTS
  ========================================================== -->

  <section class="mt-20 border-t border-slate-200 pt-20 dark:border-slate-800">
    <div class="mx-auto max-w-6xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">Другие OEM и ODM решения</p>

      <h3 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        Другие малые бытовые приборы
      </h3>

      <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-400">
        Помимо электрических рисоварок, мы предлагаем OEM и ODM производство других категорий малой бытовой техники для
        международных B2B покупателей.
      </p>

      <div class="mx-auto mt-12 grid max-w-5xl gap-5 md:grid-cols-3">
        <!-- Electric Kettle -->

        <a
          href="/electric-kettle-manufacturer"
          class="group rounded-2xl border border-slate-200 bg-slate-50 px-7 py-8 text-left transition duration-300 hover:-translate-y-1 hover:border-accent/30 hover:bg-white hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:bg-slate-800"
        >
          <div class="flex items-start justify-between">
            <span class="text-sm font-semibold text-slate-400"> 01 </span>

            <span
              class="text-xl text-slate-300 transition duration-300 group-hover:translate-x-1 group-hover:text-accent"
            >
              →
            </span>
          </div>

          <h4 class="mt-7 text-xl font-bold text-slate-900 transition group-hover:text-accent dark:text-white">
            Electric Kettle Manufacturer
          </h4>

          <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">
            Электрические чайники OEM и ODM для импортеров, дистрибьюторов и private label брендов.
          </p>

          <div class="mt-6 text-sm font-semibold text-accent">Подробнее →</div>
        </a>

        <!-- Pressure Cooker -->

        <a
          href="/electric-pressure-cooker-manufacturer"
          class="group rounded-2xl border border-slate-200 bg-slate-50 px-7 py-8 text-left transition duration-300 hover:-translate-y-1 hover:border-accent/30 hover:bg-white hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:bg-slate-800"
        >
          <div class="flex items-start justify-between">
            <span class="text-sm font-semibold text-slate-400"> 02 </span>

            <span
              class="text-xl text-slate-300 transition duration-300 group-hover:translate-x-1 group-hover:text-accent"
            >
              →
            </span>
          </div>

          <h4 class="mt-7 text-xl font-bold text-slate-900 transition group-hover:text-accent dark:text-white">
            Electric Pressure Cooker Manufacturer
          </h4>

          <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">
            Электрические скороварки OEM и ODM для импортных проектов и private label брендов.
          </p>

          <div class="mt-6 text-sm font-semibold text-accent">Подробнее →</div>
        </a>

        <!-- Lunch Box -->

        <a
          href="/electric-lunch-box-manufacturer"
          class="group rounded-2xl border border-slate-200 bg-slate-50 px-7 py-8 text-left transition duration-300 hover:-translate-y-1 hover:border-accent/30 hover:bg-white hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:bg-slate-800"
        >
          <div class="flex items-start justify-between">
            <span class="text-sm font-semibold text-slate-400"> 03 </span>

            <span
              class="text-xl text-slate-300 transition duration-300 group-hover:translate-x-1 group-hover:text-accent"
            >
              →
            </span>
          </div>

          <h4 class="mt-7 text-xl font-bold text-slate-900 transition group-hover:text-accent dark:text-white">
            Electric Lunch Box Manufacturer
          </h4>

          <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">
            Электрические ланч-боксы OEM и ODM для оптовых компаний, дистрибьюторов и международных брендов.
          </p>

          <div class="mt-6 text-sm font-semibold text-accent">Подробнее →</div>
        </a>
      </div>
    </div>
  </section>

  <!-- =========================================================
       WHY CHOOSE YOLEC
  ========================================================== -->

  <section class="bg-slate-50 py-20 dark:bg-slate-900 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-14 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-accent">Прямой производитель</p>

          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
            Больше, чем просто поставщик рисоварок
          </h2>

          <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
            Для B2B покупателя выбор производителя — это не только вопрос цены. Стабильность производства, контроль
            качества, возможность персонализации и коммуникация напрямую влияют на результат проекта.
          </p>

          <p class="mt-5 leading-7 text-slate-600 dark:text-slate-400">
            YOLEC Electric напрямую работает с импортерами, дистрибьюторами и международными брендами, помогая
            адаптировать продукцию под коммерческие требования конкретного рынка.
          </p>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div class="rounded-2xl bg-white p-6 shadow-sm dark:bg-slate-800">
            <div class="text-lg font-bold text-slate-900 dark:text-white">Прямое производство</div>

            <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
              Прямая коммуникация с фабрикой на всех этапах проекта.
            </p>
          </div>

          <div class="rounded-2xl bg-white p-6 shadow-sm dark:bg-slate-800">
            <div class="text-lg font-bold text-slate-900 dark:text-white">Собственный R&D</div>

            <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
              Техническая поддержка при адаптации и разработке продукции.
            </p>
          </div>

          <div class="rounded-2xl bg-white p-6 shadow-sm dark:bg-slate-800">
            <div class="text-lg font-bold text-slate-900 dark:text-white">Контроль качества</div>

            <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
              Контроль продукции на разных этапах производственного процесса.
            </p>
          </div>

          <div class="rounded-2xl bg-white p-6 shadow-sm dark:bg-slate-800">
            <div class="text-lg font-bold text-slate-900 dark:text-white">Стабильное производство</div>

            <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
              Производственные возможности для OEM заказов различного объема.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       OEM ODM
  ========================================================== -->

  <section class="bg-white py-20 dark:bg-slate-950 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-14 lg:grid-cols-2 lg:items-center">
        <div class="overflow-hidden rounded-2xl">
          <img
            src="/images/blog/46.jpg"
            alt="OEM и ODM производство электрических рисоварок в Китае"
            class="w-full object-cover"
            loading="lazy"
          />
        </div>

        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-accent">OEM / ODM</p>

          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
            Персонализация рисоварки под ваш бренд
          </h2>

          <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
            OEM проект не обязательно начинать с разработки полностью нового продукта. Вы можете выбрать существующую
            модель и изменить необходимые элементы в соответствии с требованиями вашего рынка.
          </p>

          <div class="mt-8 space-y-5">
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white">Логотип и фирменный стиль</h3>
              <p class="mt-1 text-slate-600 dark:text-slate-400">
                Нанесение логотипа и других элементов фирменной идентичности.
              </p>
            </div>

            <div>
              <h3 class="font-bold text-slate-900 dark:text-white">Цвет и отделка</h3>
              <p class="mt-1 text-slate-600 dark:text-slate-400">
                Выбор цвета и внешнего оформления в соответствии с вашей продуктовой линейкой.
              </p>
            </div>

            <div>
              <h3 class="font-bold text-slate-900 dark:text-white">Функции и характеристики</h3>
              <p class="mt-1 text-slate-600 dark:text-slate-400">
                Вместимость, мощность, управление и другие характеристики в зависимости от выбранной модели и проекта.
              </p>
            </div>

            <div>
              <h3 class="font-bold text-slate-900 dark:text-white">Упаковка</h3>
              <p class="mt-1 text-slate-600 dark:text-slate-400">
                Коробки, инструкции, этикетки и другие материалы для вашего бренда.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       FACTORY
  ========================================================== -->

  <section class="bg-slate-900 py-20 text-white lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-slate-400">Производственные возможности</p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          Фабрика, готовая к OEM проектам электрических рисоварок
