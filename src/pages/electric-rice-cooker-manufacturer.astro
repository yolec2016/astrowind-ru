---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Electric Rice Cooker Manufacturer in China | OEM & ODM',
  description:
    'Electric rice cooker manufacturer in China для импортеров, дистрибьюторов и private label брендов. OEM и ODM производство электрических рисоварок, контроль качества, персонализация и поставки напрямую с фабрики.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

  <!-- =========================================================
       HERO
  ========================================================== -->

  <section class="relative overflow-hidden bg-slate-50 dark:bg-slate-900">

    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-28">

      <div class="grid items-center gap-14 lg:grid-cols-2">

        <!-- LEFT -->

        <div>

          <div class="mb-6 inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-600 shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
            OEM и ODM · Производство в Китае
          </div>

          <h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-5xl lg:text-6xl">
            Electric Rice Cooker Manufacturer
