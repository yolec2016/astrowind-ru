---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Китайский OEM/ODM завод кухонной техники — прямые поставки из Чжуншана',
  description:
    'Китайский OEM/ODM производитель мелкой кухонной техники: электрочайники, рисоварки, скороварки и ланч-боксы оптом для импортеров, дистрибьюторов и частных брендов. Прямые поставки с фабрики в Чжуншане.',
  ignoreTitleTemplate: true,
};

// E-E-A-T: AggregateRating + отзывы B2B-партнёров
const orgRatingSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://yoleckitchen.xyz/#organization-rating',
  name: 'YOLEC Electric',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    reviewCount: '128',
    bestRating: '5',
    worstRating: '1',
  },
  review: [
    {
      '@type': 'Review',
      author: { '@type': 'Organization', name: 'ООО «ТеплоТорг»' },
      reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
      datePublished: '2025-11-03',
      reviewBody:
        'Запускали с YOLEC линейку электрочайников с двойной стенкой под нашей торговой маркой. Прямая коммуникация с заводом, образцы получили за 8 дней, партия отгружена в срок. Рекомендуем как надежного OEM-партнера.',
      publisher: { '@type': 'Organization', name: 'YOLEC Electric' },
    },
    {
      '@type': 'Review',
      author: { '@type': 'Organization', name: '«ДомБыт Опт»' },
      reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
      datePublished: '2025-09-22',
      reviewBody:
        'Заказывали чайники с гусиным носиком для кофейного сегмента. Контроль температуры точный, покрытие корпуса безупречное, а MOQ позволил запустить линейку с минимальными рисками.',
      publisher: { '@type': 'Organization', name: 'YOLEC Electric' },
    },
    {
      '@type': 'Review',
      author: { '@type': 'Organization', name: 'ООО «ВостокТрейд»' },
      reviewRating: { '@type': 'Rating', ratingValue: '4', bestRating: '5' },
      datePublished: '2025-07-15',
      reviewBody:
        'Импортируем рисоварки и мультиварки-скороварки второй год. Партии стабильные по качеству, поддержка при аудите фабрики и инспекции отгрузки делает процесс предсказуемым.',
      publisher: { '@type': 'Organization', name: 'YOLEC Electric' },
    },
    {
      '@type': 'Review',
      author: { '@type': 'Organization', name: 'ООО «Кухонный Альянс»' },
      reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
      datePublished: '2026-02-11',
      reviewBody:
        'Поставляем технику для сегмента HoReCa. Чайники YOLEC в гостиничном исполнении компактные и долговечные, есть сертификаты под требования ЕАЭС. Экспортная упаковка выдержала все морские отправки.',
      publisher: { '@type': 'Organization', name: 'YOLEC Electric' },
    },
  ],
};
---

<Layout metadata={metadata} structuredData={orgRatingSchema}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Получить предложение',
        href: getPermalink('/contact'),
        icon: 'tabler:message',
      },
      {
        text: 'Смотреть продукцию',
        href: getPermalink('/electric-kettle-manufacturer'),
      },
    ]}
    image={{
      src: '~/assets/images/hero-image.png',
      alt: 'OEM/ODM производитель мелкой кухонной техники в Китае — электрические чайники, чайники для кофе, рисоварки, мультиварки, скороварки и электрические ланч-боксы',
    }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white">OEM/ODM завод</span>
      <br />
      мелкой кухонной техники
      <br />
      в Китае
    </Fragment>

    <Fragment slot="subtitle">
      Китайский производитель мелкой кухонной техники, предоставляющий услуги OEM и ODM для импортеров, дистрибьюторов,
      владельцев брендов и розничных сетей. Мы производим электрические чайники, чайники для кофе, рисоварки,
      мультиварки, скороварки и электрические ланч-боксы, предлагая разработку продукции, изготовление пресс-форм,
      дизайн упаковки, контроль качества, сертификацию и экспортную поддержку. Помогаем B2B-партнёрам создавать
      конкурентоспособную продукцию под собственным брендом и успешно выводить её на рынок.
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note
    title="OEM/ODM производитель мелкой кухонной техники в Китае"
    description="Разработка продукции • Производство • Контроль качества • Сертификация • Экспорт"
  />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Почему выбирают наш завод"
    title="Почему международные B2B-покупатели выбирают YOLEC"
    subtitle="Мы сотрудничаем с импортерами, дистрибьюторами, оптовыми компаниями и владельцами брендов, которым требуется надежный OEM/ODM-производитель в Китае."
    items={[
      {
        title: 'OEM и ODM производство',
        description:
          'Производство мелкой кухонной техники по вашим требованиям: логотип, упаковка, цвет, технические характеристики и индивидуальная комплектация.',
        icon: 'tabler:settings',
      },
      {
        title: 'Собственное производство',
        description:
          'Современные производственные линии, участки литья пластика, обработки металла и профессиональная сборка для стабильного серийного производства.',
        icon: 'tabler:building-factory',
      },
      {
        title: 'Контроль качества',
        description:
          'Многоступенчатый контроль качества включает проверку сырья, производственного процесса, функциональное тестирование и финальную инспекцию перед отгрузкой.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Экспортная поддержка',
        description:
          'Поддерживаем экспортные проекты, помогая подготовить необходимые документы и организовать международную доставку.',
        icon: 'tabler:world',
      },
      {
        title: 'Поддержка международной сертификации',
        description:
          'Поддерживаем подготовку продукции к международной сертификации, включая CE, CB, LFGB, RoHS и другие требования различных рынков.',
        icon: 'tabler:certificate',
      },
      {
        title: 'Быстрое коммерческое предложение',
        description:
          'Наша команда оперативно подготовит коммерческое предложение, рассчитает стоимость проекта и ответит на технические вопросы.',
        icon: 'tabler:message-circle',
      },

      {
        title: 'Разработка продукции',
        description:
          'Помогаем разрабатывать новые модели, улучшать существующие изделия и адаптировать продукцию под требования различных рынков.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Изготовление пресс-форм',
        description:
          'Собственная разработка и изготовление пресс-форм позволяют быстрее запускать новые проекты и контролировать качество продукции.',
        icon: 'tabler:tool',
      },
      {
        title: 'Дизайн упаковки',
        description:
          'Разрабатываем упаковку, инструкции и оформление продукции в соответствии с требованиями вашего бренда и целевого рынка.',
        icon: 'tabler:package',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="О заводе"
    title="Китайский производитель кухонной техники с OEM/ODM услугами"
    items={[
      {
        title: 'Завод основан в 2015 году',
        description: 'Более 10 лет опыта как OEM/ODM производитель кухонной техники в Китае.',
      },
      {
        title: 'Полный производственный цикл',
        description: 'Металлообработка, литьё пластика, сборка и контроль качества — всё на одном заводе.',
      },
      {
        title: 'OEM и ODM проекты',
        description:
          'Поддерживаем производство продукции под брендом заказчика для импортеров, дистрибьюторов и международных B2B-компаний.',
      },
    ]}
    image={{
      src: '~/assets/images/Small-Home-Appliance-Manufacturer.png',
      alt: 'OEM ODM завод кухонной техники Китай',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        OEM/ODM завод кухонной техники в Китае для оптовых покупателей
      </h3>

      Мы производим электрические чайники, рисоварки, мультиварки, скороварки и ланч-боксы для импортеров,
      дистрибьюторов и владельцев брендов, которым нужен надежный поставщик кухонной техники из Китая.
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    tagline="Производственные возможности"
    title="Массовое производство кухонной техники оптом"
    items={[
      {
        title: '3 производственные линии завода',
        description: 'Стабильное производство электрических чайников, рисоварок и другой техники.',
      },
      {
        title: 'Внутренний QC контроль',
        description: 'Контроль качества на каждом этапе производства на фабрике.',
      },
      {
        title: 'OEM ODM гибкость',
        description: 'Поддержка индивидуального дизайна, упаковки и технических требований.',
      },
      {
        title: 'Быстрые образцы',
        description: 'Разработка и отправка образцов для проверки перед массовым заказом.',
      },
    ]}
    image={{
      src: '~/assets/images/factory.png',
      alt: 'Производство кухонной техники Китай завод',
    }}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    tagline="Ассортимент завода"
    title="Кухонная техника оптом от производителя в Китае"
    items={[
      {
        title: 'Электрические чайники оптом',
        description: 'Заводское производство стеклянных и нержавеющих моделей.',
      },
      {
        title: 'Рисоварки и мультиварки OEM',
        description: 'Модели для домашнего и коммерческого использования.',
      },
      {
        title: 'Скороварки',
        description: 'Энергоэффективные и безопасные решения от китайского завода.',
      },
      {
        title: 'Ланч-боксы электрические',
        description: 'Популярная продукция для розничных и онлайн рынков.',
      },
    ]}
    image={{
      src: '~/assets/images/gooseneck-coffee-kettle-new.png',
      alt: 'Ассортимент кухонной техники Китай завод',
    }}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="Как работает OEM/ODM завод в Китае"
    items={[
      {
        title: 'Запрос от клиента',
        description: 'Вы отправляете требования: продукт, объем, рынок, упаковка.',
        icon: 'tabler:message',
      },
      {
        title: 'Коммерческое предложение',
        description: 'Цена от завода, MOQ, сроки и условия поставки.',
        icon: 'tabler:file-text',
      },
      {
        title: 'OEM образцы',
        description: 'Производство образцов для подтверждения качества.',
        icon: 'tabler:flask',
      },
      {
        title: 'Массовое производство',
        description: 'Запуск фабрики и контроль качества.',
        icon: 'tabler:settings-cog',
      },
      {
        title: 'Отгрузка',
        description: 'Финальная проверка и экспорт кухонной техники.',
        icon: 'tabler:truck',
      },
    ]}
