---
import Layout from '~/layouts/PageLayout.astro';
import ProductsGrid from '~/components/widgets/ProductsGrid.astro';

const metadata = {
  title: 'Производитель электрических чайников в Китае — OEM/ODM завод',
  description:
    'OEM/ODM производство электрических чайников в Китае: стекло, нержавейка, gooseneck, контроль качества и поставки напрямую с фабрики Чжуншана.',
  ignoreTitleTemplate: true,
};

const products = [
  {
    model: 'HS-15DW07',
    tag: 'Массовый сегмент',
    title: 'Электрочайник 1,5 л — базовая модель для оптовых закупок и маркетплейсов.',
    image: '/images/products/kettle/HS-15DW07-1.jpg',
    image2: '/images/products/kettle/HS-15DW07-2.jpg',
    url: 'https://www.yolec-electronics.com/products/electric-water-kettle/oem-1-5l-basic-electric-kettle-bulk-wholesale-hs-15dw07/',
  },
  {
    model: 'ZT-15BL95',
    tag: 'Нержавеющая сталь',
    title: 'Чайник 1,5 л с синей светодиодной подсветкой, корпус из нержавеющей стали.',
    image: '/images/products/kettle/ZT-15BL95-1.jpg',
    image2: '/images/products/kettle/ZT-15BL95-2.jpg',
    url: 'https://www.yolec-electronics.com/products/electric-water-kettle/oem-1-5l-blue-light-electric-kettle-stainless-steel-zt-15bl95/',
  },
  {
    model: 'HS-10DK22',
    tag: 'Gooseneck / для кофе',
    title: 'Кофейный чайник с гусиной шеей 1,0 л, регулировка температуры и поддержание нагрева.',
    image: '/images/products/kettle/HS-10DK22-1.jpg',
    url: 'https://www.yolec-electronics.com/products/electric-coffee-kettle/oem-1-0l-cost-effective-gooseneck-coffee-kettle-bulk-hs-bk10/',
  },
  {
    model: 'HS-10DK10',
    tag: 'Для кофе',
    title: 'Чайник-«гусиная шея» 1,0 л с быстрым нагревом для кофейного сегмента.',
    image: '/images/products/kettle/HS-10DK10-1.jpg',
    image2: '/images/products/kettle/HS-10DK10-2.jpg',
    url: 'https://www.yolec-electronics.com/products/electric-coffee-kettle/oem-1-0l-basic-gooseneck-coffee-kettle-fast-boil-hs-10dk10/',
  },
  {
    model: 'HS-YSH18',
    tag: 'Стеклянный',
    title: 'Стеклянный чайник 1,8 л из боросиликатного стекла с подсветкой при нагреве.',
    image: '/images/products/kettle/HS-YSH18-1.jpg',
    image2: '/images/products/kettle/HS-YSH18-2.png',
    url: 'https://www.yolec-electronics.com/products/glass-electric-kettle/oem-1-8l-large-capacity-glass-electric-kettle-hs-ysh18/',
  },
  {
    model: 'HS-DZ66',
    tag: 'Чайный набор',
    title: 'Чайная станция Smart: электрический чайник и чайник для заваривания в одном наборе.',
    image: '/images/products/kettle/HS-DZ66-1.jpg',
    image2: '/images/products/kettle/HS-DZ66-2.jpg',
    url: 'https://www.yolec-electronics.com/products/electric-kettle-set/oem-smart-electric-kettle-set-custom-tea-station-hs-dz66/',
  },
];
---

<Layout metadata={metadata}>
  <!-- =========================================================
       HERO
  ========================================================== -->

  <section class="relative overflow-hidden bg-slate-50 dark:bg-slate-900">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-28">
      <div class="grid items-center gap-14 lg:grid-cols-2">
        <!-- LEFT -->

        <div>
          <div
            class="mb-6 inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-600 shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300"
          >
            Electric Kettle Manufacturer · Supplier & Factory
          </div>

          <h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-5xl lg:text-6xl">
            Производитель электрических чайников
            <span class="block text-accent"> в Китае — завод-поставщик </span>
          </h1>

          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">
            Производим электрические чайники для импортёров, дистрибьюторов, оптовых компаний и private label брендов.
            Предлагаем прямые поставки с фабрики, OEM и ODM производство, индивидуальную комплектацию и решения для
            разных международных рынков.
          </p>

          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="/contact"
              class="inline-flex items-center rounded-lg bg-accent px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:opacity-90"
            >
              Получить предложение
            </a>

            <a
              href="https://wa.me/8613922332584"
              class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-6 py-3.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:bg-slate-800 dark:text-white dark:hover:bg-slate-700"
            >
              Связаться в WhatsApp
            </a>
          </div>

          <div class="mt-10 flex flex-wrap gap-x-8 gap-y-4 text-sm text-slate-600 dark:text-slate-400">
            <div>
              <strong class="text-slate-900 dark:text-white">10+</strong>
              лет производства
            </div>

            <div>
              <strong class="text-slate-900 dark:text-white">20 000 м²</strong>
              площадь фабрики
            </div>

            <div>
              <strong class="text-slate-900 dark:text-white">200+</strong>
              сотрудников
            </div>
          </div>
        </div>

        <!-- RIGHT -->

        <div class="relative">
          <div
            class="overflow-hidden rounded-2xl bg-white shadow-2xl ring-1 ring-slate-200 dark:bg-slate-800 dark:ring-slate-700"
          >
            <img
              src="/images/blog/47.jpg"
              alt="Electric kettle manufacturer in China - производство электрических чайников"
              class="h-auto w-full object-cover"
              loading="eager"
            />
          </div>

          <div
            class="absolute -bottom-6 -left-6 hidden rounded-xl bg-white p-5 shadow-xl ring-1 ring-slate-200 dark:bg-slate-800 dark:ring-slate-700 sm:block"
          >
            <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Прямое производство</p>

            <p class="mt-1 text-lg font-bold text-slate-900 dark:text-white">OEM / ODM</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       TRUST / STATS
  ========================================================== -->

  <section class="border-y border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950">
    <div class="mx-auto grid max-w-6xl grid-cols-2 divide-x divide-slate-200 dark:divide-slate-800 lg:grid-cols-4">
      <div class="px-6 py-8 text-center">
        <div class="text-3xl font-bold text-slate-900 dark:text-white">10+</div>
        <div class="mt-1 text-sm text-slate-500">Лет производства</div>
      </div>

      <div class="px-6 py-8 text-center">
        <div class="text-3xl font-bold text-slate-900 dark:text-white">20 000 м²</div>
        <div class="mt-1 text-sm text-slate-500">Площадь фабрики</div>
      </div>

      <div class="border-t px-6 py-8 text-center dark:border-slate-800 lg:border-t-0">
        <div class="text-3xl font-bold text-slate-900 dark:text-white">200+</div>
        <div class="mt-1 text-sm text-slate-500">Сотрудников</div>
      </div>

      <div class="border-t px-6 py-8 text-center dark:border-slate-800 lg:border-t-0">
        <div class="text-3xl font-bold text-slate-900 dark:text-white">3</div>
        <div class="mt-1 text-sm text-slate-500">Производственные линии</div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       PRODUCT RANGE
  ========================================================== -->

  <section class="bg-white py-20 dark:bg-slate-950 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-accent">Ассортимент</p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
          Электрические чайники для разных рынков
        </h2>

        <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
          Мы предлагаем несколько типов электрических чайников, чтобы импортёры и дистрибьюторы могли подобрать модель
          под свой ценовой сегмент, дизайн, функциональность и целевой рынок.
        </p>
      </div>

      <div class="mt-12 overflow-hidden rounded-2xl">
        <img
          src="/images/blog/14.jpg"
          alt="Электрические чайники для импортёров и дистрибьюторов"
          class="h-auto w-full object-cover"
          loading="lazy"
        />
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-7 dark:border-slate-800 dark:bg-slate-900">
          <div class="text-2xl font-bold text-slate-900 dark:text-white">01</div>

          <h3 class="mt-5 text-xl font-bold text-slate-900 dark:text-white">Чайники из нержавеющей стали</h3>

          <p class="mt-3 leading-7 text-slate-600 dark:text-slate-400">
            Практичные и долговечные модели для дистрибьюторов и брендов, которым важно оптимальное соотношение цены и
            качества.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-7 dark:border-slate-800 dark:bg-slate-900">
          <div class="text-2xl font-bold text-slate-900 dark:text-white">02</div>

          <h3 class="mt-5 text-xl font-bold text-slate-900 dark:text-white">Чайники с регулировкой температуры</h3>

          <p class="mt-3 leading-7 text-slate-600 dark:text-slate-400">
            Электронное управление и настройка температуры для продукции среднего и более высокого ценового сегмента.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-7 dark:border-slate-800 dark:bg-slate-900">
          <div class="text-2xl font-bold text-slate-900 dark:text-white">03</div>

          <h3 class="mt-5 text-xl font-bold text-slate-900 dark:text-white">Чайники с узким носиком</h3>

          <p class="mt-3 leading-7 text-slate-600 dark:text-slate-400">
            Модели gooseneck для кофе, чая и pour-over, где важны точность и контроль потока воды.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-7 dark:border-slate-800 dark:bg-slate-900">
          <div class="text-2xl font-bold text-slate-900 dark:text-white">04</div>

          <h3 class="mt-5 text-xl font-bold text-slate-900 dark:text-white">Private label чайники</h3>

          <p class="mt-3 leading-7 text-slate-600 dark:text-slate-400">
            Персонализация логотипа, цвета, покрытия, упаковки и других параметров в соответствии с требованиями бренда.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       RELATED PRODUCTS
  ========================================================== -->

  <section class="border-t border-slate-200 bg-white py-20 dark:border-slate-800 dark:bg-slate-950">
    <div class="mx-auto max-w-6xl px-6 text-center lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">Другие OEM / ODM решения</p>

      <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        Другие категории малой бытовой техники
      </h2>

      <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-400">
        Помимо электрических чайников, мы предлагаем OEM и ODM производство других категорий малой бытовой техники для
        международных B2B клиентов.
      </p>

      <div class="mx-auto mt-12 grid max-w-5xl gap-5 md:grid-cols-3">
        <!-- Rice Cooker -->

        <a
          href="/electric-rice-cooker-manufacturer"
          class="group rounded-2xl border border-slate-200 bg-slate-50 px-7 py-8 text-left transition duration-300 hover:-translate-y-1 hover:border-accent/30 hover:bg-white hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:bg-slate-800"
        >
          <div class="flex items-start justify-between">
            <span class="text-sm font-semibold text-slate-400"> 01 </span>

            <span
              class="text-xl text-slate-300 transition duration-300 group-hover:translate-x-1 group-hover:text-accent"
            >
              →
            </span>
          </div>

          <h3 class="mt-7 text-xl font-bold text-slate-900 transition group-hover:text-accent dark:text-white">
            Electric Rice Cooker Manufacturer
          </h3>

          <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">
            Производство электрических рисоварок OEM и ODM для импортёров, дистрибьюторов и private label брендов.
          </p>

          <div class="mt-6 text-sm font-semibold text-accent">Подробнее →</div>
        </a>

        <!-- Pressure Cooker -->

        <a
          href="/electric-pressure-cooker-manufacturer"
          class="group rounded-2xl border border-slate-200 bg-slate-50 px-7 py-8 text-left transition duration-300 hover:-translate-y-1 hover:border-accent/30 hover:bg-white hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:bg-slate-800"
        >
          <div class="flex items-start justify-between">
            <span class="text-sm font-semibold text-slate-400"> 02 </span>

            <span
              class="text-xl text-slate-300 transition duration-300 group-hover:translate-x-1 group-hover:text-accent"
            >
              →
            </span>
          </div>

          <h3 class="mt-7 text-xl font-bold text-slate-900 transition group-hover:text-accent dark:text-white">
            Electric Pressure Cooker Manufacturer
          </h3>

          <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">
            Электрические скороварки OEM и ODM для импортёров, дистрибьюторов и private label проектов.
          </p>

          <div class="mt-6 text-sm font-semibold text-accent">Подробнее →</div>
        </a>

        <!-- Lunch Box -->

        <a
          href="/electric-lunch-box-manufacturer"
          class="group rounded-2xl border border-slate-200 bg-slate-50 px-7 py-8 text-left transition duration-300 hover:-translate-y-1 hover:border-accent/30 hover:bg-white hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:bg-slate-800"
        >
          <div class="flex items-start justify-between">
            <span class="text-sm font-semibold text-slate-400"> 03 </span>

            <span
              class="text-xl text-slate-300 transition duration-300 group-hover:translate-x-1 group-hover:text-accent"
            >
              →
            </span>
          </div>

          <h3 class="mt-7 text-xl font-bold text-slate-900 transition group-hover:text-accent dark:text-white">
            Electric Lunch Box Manufacturer
          </h3>

          <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">
            Электрические ланч-боксы OEM и ODM для оптовых компаний, дистрибьюторов и международных брендов.
          </p>

          <div class="mt-6 text-sm font-semibold text-accent">Подробнее →</div>
        </a>
      </div>
    </div>
  </section>

  <!-- =========================================================
       WHY CHOOSE YOLEC
  ========================================================== -->

  <section class="bg-slate-50 py-20 dark:bg-slate-900 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-14 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-accent">Прямой производитель</p>

          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
            Не просто поставщик электрических чайников
          </h2>

          <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
            Для B2B покупателя выбор производителя — это не только вопрос цены. Стабильность производства, контроль
            качества, возможности кастомизации и коммуникация напрямую влияют на результат проекта.
          </p>

          <p class="mt-5 leading-7 text-slate-600 dark:text-slate-400">
            YOLEC Electric напрямую работает с импортёрами, дистрибьюторами и международными брендами, помогая им
            разрабатывать и производить электрические чайники под требования конкретного рынка.
          </p>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div class="rounded-2xl bg-white p-6 shadow-sm dark:bg-slate-800">
            <div class="text-lg font-bold text-slate-900 dark:text-white">Прямое производство</div>

            <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
              Прямая коммуникация с фабрикой на всех этапах проекта.
            </p>
          </div>

          <div class="rounded-2xl bg-white p-6 shadow-sm dark:bg-slate-800">
            <div class="text-lg font-bold text-slate-900 dark:text-white">Собственный R&D</div>

            <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
              Техническая поддержка при адаптации и разработке продукции.
            </p>
          </div>

          <div class="rounded-2xl bg-white p-6 shadow-sm dark:bg-slate-800">
            <div class="text-lg font-bold text-slate-900 dark:text-white">Контроль качества</div>

            <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
              Контроль на разных этапах производства и перед отгрузкой.
            </p>
          </div>

          <div class="rounded-2xl bg-white p-6 shadow-sm dark:bg-slate-800">
            <div class="text-lg font-bold text-slate-900 dark:text-white">Стабильное производство</div>

            <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
              Возможность поддерживать OEM заказы разных объёмов.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       OEM ODM
  ========================================================== -->

  <section class="bg-white py-20 dark:bg-slate-950 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-14 lg:grid-cols-2 lg:items-center">
        <div class="overflow-hidden rounded-2xl">
          <img
            src="/images/blog/30.jpg"
            alt="OEM ODM производство электрических чайников на заказ"
            class="h-auto w-full object-cover"
            loading="lazy"
          />
        </div>

        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-accent">OEM / ODM</p>

          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
            Электрический чайник под требования вашего бренда
          </h2>

          <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
            OEM проект не обязательно начинать с нуля. Можно выбрать существующую модель и изменить только те элементы,
            которые действительно нужны вашему рынку и бренду.
          </p>

          <div class="mt-8 space-y-5">
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white">Логотип и фирменный стиль</h3>
              <p class="mt-1 text-slate-600 dark:text-slate-400">
                Нанесение логотипа и других элементов фирменной идентичности.
              </p>
            </div>

            <div>
              <h3 class="font-bold text-slate-900 dark:text-white">Цвет и отделка</h3>
              <p class="mt-1 text-slate-600 dark:text-slate-400">
                Подбор цвета, покрытия и визуального исполнения под линейку бренда.
              </p>
            </div>

            <div>
              <h3 class="font-bold text-slate-900 dark:text-white">Функции и характеристики</h3>
              <p class="mt-1 text-slate-600 dark:text-slate-400">
                Объём, мощность, управление и другие характеристики в зависимости от выбранной модели и требований
                проекта.
              </p>
            </div>

            <div>
              <h3 class="font-bold text-slate-900 dark:text-white">Упаковка</h3>
              <p class="mt-1 text-slate-600 dark:text-slate-400">
                Коробки, инструкции, этикетки и другие упаковочные материалы под требования бренда.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       FACTORY
  ========================================================== -->

  <section class="bg-slate-900 py-20 text-white lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
