---
import Layout from '~/layouts/PageLayout.astro';
import ProductsGrid from '~/components/widgets/ProductsGrid.astro';

const metadata = {
  title: 'Производитель электрических скороварок в Китае — OEM/ODM завод',
  description:
    'OEM/ODM производство электрических скороварок 4–12 л в Китае: 10+ программ, нержавеющая сталь 304, сертификация CE/CB/EAC, испытания давлением на фабрике Чжуншана.',
  ignoreTitleTemplate: true,
};

const products = [
  {
    model: 'HS-PC588',
    tag: '5 л · средний сегмент',
    title: 'Электрическая скороварка 5 л — массовая модель для оптовых закупок.',
    image: '/images/products/pressure/HS-PC588-1.jpg',
    image2: '/images/products/pressure/HS-PC588-2.jpg',
    url: 'https://www.yolec-electronics.com/products/pressure-cooker/oem-5l-mid-range-electric-pressure-cooker-bulk-hs-pc588/',
  },
  {
    model: 'HS-613A',
    tag: '6 л · Smart',
    title: 'Умная скороварка 5/6 л с цифровым управлением и набором программ.',
    image: '/images/products/pressure/HS-613A-1.jpg',
    image2: '/images/products/pressure/HS-613A-2.jpg',
    url: 'https://www.yolec-electronics.com/products/pressure-cooker/oem-5l-6l-upgrade-electric-pressure-cooker-smart-control-hs-513a-613a/',
  },
  {
    model: 'HS-PC636',
    tag: '6 л · премиум',
    title: 'Премиальная скороварка 6 л для private label и верхнего ценового сегмента.',
    image: '/images/products/pressure/HS-PC636-1.jpg',
    image2: '/images/products/pressure/HS-PC636-2.jpg',
    url: 'https://www.yolec-electronics.com/products/pressure-cooker/oem-6l-premium-electric-pressure-cooker-private-label-hs-pc636/',
  },
  {
    model: 'HS-AP60B',
    tag: '6 л · эконом',
    title: 'Бюджетная скороварка 6 л с алюминиевой чашей для базовой линейки.',
    image: '/images/products/pressure/HS-AP60B-1.png',
    image2: '/images/products/pressure/HS-AP60B-2.jpg',
    url: 'https://www.yolec-electronics.com/products/pressure-cooker/oem-6l-aluminum-pot-electric-pressure-cooker-cost-effective-hs-ap60b/',
  },
  {
    model: 'HS-616M',
    tag: '5/6 л · 16 программ',
    title: 'Матовая скороварка 5/6 л с 16 программами: рис, суп, тушение, выпечка.',
    image: '/images/products/pressure/HS-616M-1.jpg',
    image2: '/images/products/pressure/HS-616M-2.png',
    url: 'https://www.yolec-electronics.com/products/pressure-cooker/oem-5l-6l-matte-finish-electric-pressure-cooker-16-functions-hs-516m-616m/',
  },
  {
    model: 'HS-A401–A1201',
    tag: '4–12 л · серия',
    title: 'Линейка скороварок из нержавеющей стали 4–12 л, включая объёмы для HoReCa.',
    image: '/images/products/pressure/HS-A401-1.png',
    image2: '/images/products/pressure/HS-A401-2.png',
    url: 'https://www.yolec-electronics.com/products/pressure-cooker/oem-4l-12l-stainless-steel-electric-pressure-cooker-custom-hs-a401-a501-a601-a801-a1001-a1201/',
  },
];
---

<Layout metadata={metadata}>
  <!-- =========================================================
       HERO
  ========================================================== -->

  <section class="relative overflow-hidden bg-slate-50 dark:bg-slate-900">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-28">
      <div class="grid items-center gap-14 lg:grid-cols-2">
        <!-- LEFT -->

        <div>
          <div
            class="mb-6 inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-600 shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300"
          >
            Electric Pressure Cooker Manufacturer · Supplier & Factory
          </div>

          <h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-5xl lg:text-6xl">
            Производитель электрических скороварок
            <span class="block text-accent"> в Китае — завод-поставщик </span>
          </h1>

          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">
            Производим электрические скороварки для импортёров, дистрибьюторов, оптовых компаний и private label
            брендов. Предлагаем прямые поставки с фабрики, OEM и ODM производство, индивидуальную настройку продукта и
            поддержку проектов для разных международных рынков.
          </p>

          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="/contact"
              class="inline-flex items-center rounded-lg bg-accent px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:opacity-90"
            >
              Запросить предложение
            </a>

            <a
              href="https://wa.me/8613922332584"
              class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-6 py-3.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:bg-slate-800 dark:text-white dark:hover:bg-slate-700"
            >
              Связаться в WhatsApp
            </a>
          </div>

          <div class="mt-10 flex flex-wrap gap-x-8 gap-y-4 text-sm text-slate-600 dark:text-slate-400">
            <div>
              <strong class="text-slate-900 dark:text-white">10+</strong>
              лет производства
            </div>

            <div>
              <strong class="text-slate-900 dark:text-white">20 000㎡</strong>
              площадь фабрики
            </div>

            <div>
              <strong class="text-slate-900 dark:text-white">200+</strong>
              сотрудников
            </div>
          </div>
        </div>

        <!-- RIGHT -->

        <div class="relative">
          <div
            class="overflow-hidden rounded-2xl bg-white shadow-2xl ring-1 ring-slate-200 dark:bg-slate-800 dark:ring-slate-700"
          >
            <img
              src="/images/blog/7.jpg"
              alt="Electric pressure cooker manufacturer in China - производство электрических скороварок"
              class="h-auto w-full object-cover"
              loading="eager"
            />
          </div>

          <div
            class="absolute -bottom-6 -left-6 hidden rounded-xl bg-white p-5 shadow-xl ring-1 ring-slate-200 dark:bg-slate-800 dark:ring-slate-700 sm:block"
          >
            <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Прямое производство</p>

            <p class="mt-1 text-lg font-bold text-slate-900 dark:text-white">OEM / ODM</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       TRUST / STATS
  ========================================================== -->

  <section class="border-y border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950">
    <div class="mx-auto grid max-w-6xl grid-cols-2 divide-x divide-slate-200 dark:divide-slate-800 lg:grid-cols-4">
      <div class="px-6 py-8 text-center">
        <div class="text-3xl font-bold text-slate-900 dark:text-white">10+</div>

        <div class="mt-1 text-sm text-slate-500">Лет производства</div>
      </div>

      <div class="px-6 py-8 text-center">
        <div class="text-3xl font-bold text-slate-900 dark:text-white">20 000㎡</div>

        <div class="mt-1 text-sm text-slate-500">Площадь фабрики</div>
      </div>

      <div class="border-t px-6 py-8 text-center dark:border-slate-800 lg:border-t-0">
        <div class="text-3xl font-bold text-slate-900 dark:text-white">200+</div>

        <div class="mt-1 text-sm text-slate-500">Сотрудников</div>
      </div>

      <div class="border-t px-6 py-8 text-center dark:border-slate-800 lg:border-t-0">
        <div class="text-3xl font-bold text-slate-900 dark:text-white">3</div>

        <div class="mt-1 text-sm text-slate-500">Производственные линии</div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       PRODUCT RANGE
  ========================================================== -->

  <section class="bg-white py-20 dark:bg-slate-950 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-widest text-accent">Ассортимент</p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
          Электрические скороварки для разных рынков
        </h2>

        <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
          Мы предлагаем решения для компаний, которым нужен стабильный производитель электрических скороварок в Китае.
          Модели могут отличаться по объёму, функциям, дизайну и комплектации в зависимости от целевого рынка и ценового
          сегмента.
        </p>
      </div>

      <!-- PRODUCT IMAGE -->

      <div class="mt-12 overflow-hidden rounded-2xl">
        <img
          src="/images/blog/32.jpg"
          alt="Электрические скороварки OEM и ODM производство в Китае"
          class="h-auto w-full object-cover"
          loading="lazy"
        />
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-7 dark:border-slate-800 dark:bg-slate-900">
          <div class="text-2xl font-bold text-slate-900 dark:text-white">01</div>

          <h3 class="mt-5 text-xl font-bold text-slate-900 dark:text-white">Электрические скороварки</h3>

          <p class="mt-3 leading-7 text-slate-600 dark:text-slate-400">
            Практичные модели для повседневного приготовления пищи, подходящие для оптовых компаний и дистрибьюторов.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-7 dark:border-slate-800 dark:bg-slate-900">
          <div class="text-2xl font-bold text-slate-900 dark:text-white">02</div>

          <h3 class="mt-5 text-xl font-bold text-slate-900 dark:text-white">Многофункциональные модели</h3>

          <p class="mt-3 leading-7 text-slate-600 dark:text-slate-400">
            Модели с несколькими режимами приготовления для брендов, ориентированных на более широкий ассортимент
            функций.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-7 dark:border-slate-800 dark:bg-slate-900">
          <div class="text-2xl font-bold text-slate-900 dark:text-white">03</div>

          <h3 class="mt-5 text-xl font-bold text-slate-900 dark:text-white">Скороварки для private label</h3>

          <p class="mt-3 leading-7 text-slate-600 dark:text-slate-400">
            Возможность адаптировать внешний вид, логотип, цвет и упаковку под собственную торговую марку.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-7 dark:border-slate-800 dark:bg-slate-900">
          <div class="text-2xl font-bold text-slate-900 dark:text-white">04</div>

          <h3 class="mt-5 text-xl font-bold text-slate-900 dark:text-white">OEM / ODM проекты</h3>

          <p class="mt-3 leading-7 text-slate-600 dark:text-slate-400">
            Разработка и настройка продукта под технические и коммерческие требования конкретного проекта.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       RELATED PRODUCTS
  ========================================================== -->

  <section class="border-t border-slate-200 bg-white py-20 dark:border-slate-800 dark:bg-slate-950">
    <div class="mx-auto max-w-6xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">Другие OEM и ODM решения</p>

      <h3 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        Другие малые бытовые приборы
      </h3>

      <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-400">
        Помимо электрических скороварок, мы производим другие категории кухонной техники для импортёров, дистрибьюторов
        и международных брендов.
      </p>

      <div class="mx-auto mt-12 grid max-w-5xl gap-5 md:grid-cols-3">
        <!-- Kettle -->

        <a
          href="/electric-kettle-manufacturer"
          class="group rounded-2xl border border-slate-200 bg-slate-50 px-7 py-8 text-left transition duration-300 hover:-translate-y-1 hover:border-accent/30 hover:bg-white hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:bg-slate-800"
        >
          <div class="flex items-start justify-between">
            <span class="text-sm font-semibold text-slate-400"> 01 </span>

            <span
              class="text-xl text-slate-300 transition duration-300 group-hover:translate-x-1 group-hover:text-accent"
            >
              →
            </span>
          </div>

          <h4 class="mt-7 text-xl font-bold text-slate-900 transition group-hover:text-accent dark:text-white">
            Electric Kettle Manufacturer
          </h4>

          <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">
            Электрические чайники OEM и ODM для импортёров, дистрибьюторов и private label брендов.
          </p>

          <div class="mt-6 text-sm font-semibold text-accent">Подробнее →</div>
        </a>

        <!-- Rice Cooker -->

        <a
          href="/electric-rice-cooker-manufacturer"
          class="group rounded-2xl border border-slate-200 bg-slate-50 px-7 py-8 text-left transition duration-300 hover:-translate-y-1 hover:border-accent/30 hover:bg-white hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:bg-slate-800"
        >
          <div class="flex items-start justify-between">
            <span class="text-sm font-semibold text-slate-400"> 02 </span>

            <span
              class="text-xl text-slate-300 transition duration-300 group-hover:translate-x-1 group-hover:text-accent"
            >
              →
            </span>
          </div>

          <h4 class="mt-7 text-xl font-bold text-slate-900 transition group-hover:text-accent dark:text-white">
            Electric Rice Cooker Manufacturer
          </h4>

          <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">
            Электрические рисоварки и мультифункциональные модели OEM и ODM для международных рынков.
          </p>

          <div class="mt-6 text-sm font-semibold text-accent">Подробнее →</div>
        </a>

        <!-- Lunch Box -->

        <a
          href="/electric-lunch-box-manufacturer"
          class="group rounded-2xl border border-slate-200 bg-slate-50 px-7 py-8 text-left transition duration-300 hover:-translate-y-1 hover:border-accent/30 hover:bg-white hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:bg-slate-800"
        >
          <div class="flex items-start justify-between">
            <span class="text-sm font-semibold text-slate-400"> 03 </span>

            <span
              class="text-xl text-slate-300 transition duration-300 group-hover:translate-x-1 group-hover:text-accent"
            >
              →
            </span>
          </div>

          <h4 class="mt-7 text-xl font-bold text-slate-900 transition group-hover:text-accent dark:text-white">
            Electric Lunch Box Manufacturer
          </h4>

          <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">
            Электрические ланч-боксы OEM и ODM для оптовых компаний, дистрибьюторов и private label брендов.
          </p>

          <div class="mt-6 text-sm font-semibold text-accent">Подробнее →</div>
        </a>
      </div>
    </div>
  </section>

  <!-- =========================================================
       WHY CHOOSE YOLEC
  ========================================================== -->

  <section class="bg-slate-50 py-20 dark:bg-slate-900 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-14 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-accent">Прямой производитель</p>

          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
            Больше, чем просто поставщик электрических скороварок
          </h2>

          <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
            Для B2B-покупателя важна не только цена продукта. Стабильность производства, контроль качества, возможность
            персонализации и оперативная коммуникация напрямую влияют на результат проекта.
          </p>

          <p class="mt-5 leading-7 text-slate-600 dark:text-slate-400">
            YOLEC Electric напрямую работает с импортёрами, дистрибьюторами и международными брендами, помогая
            адаптировать продукцию под конкретные требования рынка.
          </p>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div class="rounded-2xl bg-white p-6 shadow-sm dark:bg-slate-800">
            <div class="text-lg font-bold text-slate-900 dark:text-white">Прямое производство</div>

            <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
              Прямая коммуникация с фабрикой на всех этапах проекта.
            </p>
          </div>

          <div class="rounded-2xl bg-white p-6 shadow-sm dark:bg-slate-800">
            <div class="text-lg font-bold text-slate-900 dark:text-white">Собственный R&D</div>

            <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
              Техническая поддержка при адаптации и разработке продукции.
            </p>
          </div>

          <div class="rounded-2xl bg-white p-6 shadow-sm dark:bg-slate-800">
            <div class="text-lg font-bold text-slate-900 dark:text-white">Контроль качества</div>

            <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
              Контроль на разных этапах производства и перед отгрузкой.
            </p>
          </div>

          <div class="rounded-2xl bg-white p-6 shadow-sm dark:bg-slate-800">
            <div class="text-lg font-bold text-slate-900 dark:text-white">Стабильное производство</div>

            <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
              Возможность поддерживать OEM-заказы разных объёмов.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       OEM ODM
  ========================================================== -->

  <section class="bg-white py-20 dark:bg-slate-950 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-14 lg:grid-cols-2 lg:items-center">
        <div class="overflow-hidden rounded-2xl">
          <img
            src="/images/blog/33.jpg"
            alt="OEM ODM производство электрических скороварок в Китае"
            class="w-full object-cover"
            loading="lazy"
          />
        </div>

        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-accent">OEM / ODM</p>

          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
            Адаптируйте электрическую скороварку под свой бренд
          </h2>

          <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
            OEM-проект не обязательно начинать с разработки полностью нового продукта. Можно выбрать подходящую базовую
            модель и изменить необходимые элементы в соответствии с требованиями вашего рынка.
          </p>

          <div class="mt-8 space-y-5">
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white">Логотип и фирменный стиль</h3>

              <p class="mt-1 text-slate-600 dark:text-slate-400">
                Нанесение логотипа и других элементов фирменного оформления на согласованную модель.
              </p>
            </div>

            <div>
              <h3 class="font-bold text-slate-900 dark:text-white">Цвет и отделка</h3>

              <p class="mt-1 text-slate-600 dark:text-slate-400">
                Возможность подобрать внешний вид продукта под существующую линейку вашей торговой марки.
              </p>
            </div>

            <div>
              <h3 class="font-bold text-slate-900 dark:text-white">Функции и характеристики</h3>

              <p class="mt-1 text-slate-600 dark:text-slate-400">
                Объём, мощность, управление, программы приготовления и другие параметры могут обсуждаться в зависимости
                от выбранной модели.
              </p>
            </div>

            <div>
              <h3 class="font-bold text-slate-900 dark:text-white">Упаковка</h3>

              <p class="mt-1 text-slate-600 dark:text-slate-400">
                Коробки, инструкции, этикетки и другие материалы могут быть адаптированы под требования private label
                проекта.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       FACTORY
  ========================================================== -->

  <section class="bg-slate-900 py-20 text-white lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
