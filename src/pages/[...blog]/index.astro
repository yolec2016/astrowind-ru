---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import merge from 'lodash.merge';
import type { ImageMetadata } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import SinglePost from '~/components/blog/SinglePost.astro';
import ToBlogLink from '~/components/blog/ToBlogLink.astro';

import { getCanonical, getPermalink } from '~/utils/permalinks';
import { getStaticPathsBlogPost, blogPostRobots } from '~/utils/blog';
import { findImage } from '~/utils/images';
import type { MetaData } from '~/types';
import RelatedPosts from '~/components/blog/RelatedPosts.astro';
import { SITE, I18N } from 'astrowind:config';

export const prerender = true;

export const getStaticPaths = (async () => {
  return await getStaticPathsBlogPost();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props as Props;

const url = getCanonical(getPermalink(post.permalink, 'post'));
const image = (await findImage(post.image)) as ImageMetadata | string | undefined;

const siteUrl = String(SITE?.site || '').replace(/\/$/, '');
const organizationId = `${siteUrl}/#organization`;

// Абсолютный URL изображения для OpenGraph и Article schema
const imageUrl =
  typeof image === 'string'
    ? image.startsWith('http')
      ? image
      : image.startsWith('/')
        ? `${siteUrl}${image}`
        : `${siteUrl}/${image}`
    : (image as ImageMetadata)?.src
      ? `${siteUrl}${(image as ImageMetadata).src}`
      : undefined;

const metadata = merge(
  {
    title: post.title,
    description: post.excerpt,
    robots: {
      index: blogPostRobots?.index,
      follow: blogPostRobots?.follow,
    },
    openGraph: {
      type: 'article',
      ...(imageUrl
        ? {
            images: [
              {
                url: imageUrl,
                width: (image as ImageMetadata)?.width,
                height: (image as ImageMetadata)?.height,
                alt: post.title,
              },
            ],
          }
        : {}),
    },
  },
  { ...(post?.metadata ? { ...post.metadata, canonical: post.metadata?.canonical || url } : {}) }
) as MetaData;

// Article schema (Google rich result)
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${url}#article`,
  headline: post.title,
  description: post.excerpt || 'Статья блога завода YOLEC Electric о производстве кухонной техники в Китае.',
  ...(imageUrl ? { image: { '@type': 'ImageObject', url: imageUrl } } : {}),
  datePublished: post.publishDate ? post.publishDate.toISOString() : undefined,
  dateModified: (post.updateDate || post.publishDate)?.toISOString(),
  author: {
    '@type': 'Person',
    name: post.author || 'Adrian YOLEC',
    givenName: 'Adrian',
    familyName: 'YOLEC',
    jobTitle: 'B2B Sales Director — Zhongshan Yangle Electric Appliance Co., Ltd. (YOLEC)',
    worksFor: { '@id': organizationId },
    affiliate: { '@id': organizationId },
    url: 'https://www.linkedin.com/in/adrian2010/',
    sameAs: ['https://wa.me/8613922332584', 'https://www.linkedin.com/in/adrian2010/'],
    knowsAbout: [
      'OEM мелкой бытовой техники',
      'Китайские фабрики',
      'B2B импорт электрочайников',
      'Логистика ЕАЭС',
      'Сертификация EAC',
      'OEM/ODM производство рисоварок',
      'Контроль качества на китайской фабрике',
    ],
    hasCredential: [
      {
        '@type': 'EducationalOccupationalCredential',
        name: 'Zhongshan Yangle Electric — верифицирован SGS, отчёт № 483515034-P+T',
      },
    ],
  },
  publisher: { '@id': organizationId },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  inLanguage: I18N?.language || 'ru',
  ...(post.category?.title ? { articleSection: post.category.title } : {}),
  ...(post.tags?.length ? { keywords: post.tags.map((t) => t.title).join(', ') } : {}),
};
---

<Layout metadata={metadata}>
  <SinglePost post={{ ...post, image: image }} url={url}>
    {post.Content && <post.Content />}
  </SinglePost>
  <ToBlogLink />
  <RelatedPosts post={post} />
</Layout>

<script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
